{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proxy-sait",
  "triggers": {
    // Check the D1 timestamp each minute; download and probe sources only after five hours.
    "crons": ["* * * * *"]
  },
  "main": "src/worker.js",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "steklo-vpn",
      "database_id": "63c7e332-c9b9-47c5-8943-cf880287beb6",
      "migrations_dir": "migrations"
    }
  ]
}
